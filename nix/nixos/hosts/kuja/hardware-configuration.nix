# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;

  boot.initrd.availableKernelModules = [
    "xhci_pci"
    "nvme"
    "usbhid"
    "usb_storage"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/8e88d2f0-edc5-4f55-a78e-0a60d457c43a";
    fsType = "ext4";
  };

  swapDevices = [ ];

  # Slightly cursed brcm-firmware from the t2-linux project. There's also a
  # built-in package, but it supposedly requires downloading a fairly large
  # file so we're just doing this for now.
  hardware.firmware = [
    (pkgs.stdenvNoCC.mkDerivation (final: {
      name = "brcm-firmware";
      src = ./firmware/brcm;
      installPhase = ''
        mkdir -p $out/lib/firmware/brcm
        cp ${final.src}/* "$out/lib/firmware/brcm"
      '';
    }))
  ];

  networking.networkmanager = {
    enable = true;

    # There's an internal adapter which shows up as a USB adapter -
    # NetworkManager sends errors relating to this interface regularly because
    # it thinks it's connected, but can't get an address, so we just tell
    # NetworkManager to pretend it doesn't exist.
    unmanaged = [ "interface-name:enp230s0f1u1" ];
  };

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";

  hardware.enableRedistributableFirmware = lib.mkDefault true;
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
